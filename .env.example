# Supabase project settings → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role secret. Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack dashboard → Settings → API Keys & Webhooks. Use the "Secret Key". Server-only.
PAYSTACK_SECRET_KEY=
# Paystack dashboard → Settings → API Keys & Webhooks. The "Public Key" — safe for the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Your deployed site origin, no trailing slash. Used to build Paystack callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary dashboard → top-right, under your account name. Not a secret —
# used only to build public image delivery URLs (res.cloudinary.com/<name>/...).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Admin notifications, sent the moment an order is confirmed paid.
# Where the notification email goes — orders@justonpointng.com.
ADMIN_NOTIFICATION_EMAIL=
# Bespoke enquiry notifications — bespoke@justonpointng.com. Falls back to
# ADMIN_NOTIFICATION_EMAIL if unset (see lib/notifications/channels/email.ts).
ADMIN_BESPOKE_EMAIL=
# The real mailbox authenticating to Spacemail (mail.spacemail.com:465,
# SSL) — info@justonpointng.com. Aliases (noreply@, orders@, support@,
# privacy@, bespoke@) can't log in on their own; mail is sent AS
# noreply@justonpointng.com (see FROM_ADDRESS in
# lib/notifications/channels/email.ts) while authenticating as this
# mailbox. Server-only.
SMTP_USER=
SMTP_PASSWORD=
# The admin's WhatsApp number to notify, any format (digits are extracted).
CALLMEBOT_PHONE=
# Message https://wa.me/34644519898 with "I allow callmebot to send me
# messages" from that WhatsApp number, then use the API key it replies
# with. Server-only.
CALLMEBOT_API_KEY=

# Abandoned checkout reminder cron (app/api/cron/abandoned-checkouts).
# Any random secret string of your choosing — set the same value here and
# as a Vercel project env var. Vercel Cron sends it automatically as
# "Authorization: Bearer <value>" when it calls the route.
CRON_SECRET=

# Google Analytics 4 measurement ID — Google Analytics → Admin → Data
# Streams → your web stream. Not a secret, it's visible in every page's
# source, but kept as an env var (like the Cloudinary/Paystack public
# values above) so it can be swapped without a code change.
NEXT_PUBLIC_GA_MEASUREMENT_ID=


