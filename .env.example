# Supabase project settings → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role secret. Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack dashboard → Settings → API Keys & Webhooks. Use the "Secret Key". Server-only.
PAYSTACK_SECRET_KEY=
# Paystack dashboard → Settings → API Keys & Webhooks. The "Public Key" — safe for the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Your deployed site origin, no trailing slash. Used to build Paystack callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


